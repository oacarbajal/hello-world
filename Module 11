# this will open file (overwrites if it exists)
with open('grades.txt', mode='w') as grades_file:
    while True:
        grade_input = input("Enter a grade (-1 to stop): ")

#prompt for grade between 0-100 or error      
        try:
            grade = float(grade_input)
            if grade == -1:
                break
            elif 0 <= grade <= 100:
                grades_file.write(f"{grade}\n")
            else:
                print("Grade must be between 0 and 100.")
        except ValueError:
            print("Invalid input. Please enter a number.")

