# Initialize variables to hold the total of grades and count of grades
total = 0.0
count = 0

print("\nGrades entered:")

# Open the grades file in read mode
with open('grades.txt', mode='r') as grades_file:
    # Loop through each line in the file
    for line in grades_file:
# Convert the line (grade) to a float after stripping whitespace
        grade = float(line.strip())
        # Print the individual grade
        print(f"{grade}")
        # Add the grade to the total
        total += grade
        # Increment the count of grades
        count += 1
# If at least one grade was processed
if count > 0:
    # Calculate the average grade
    average = total / count
    # Print the total, count, and average of the grades
    print(f"\nTotal of grades: {total}") 
    print(f"Number of grades: {count}")
    print(f"Average grade: {average:.2f}")
else:
    # Handle case where no grades were found in the file
    print("No grades found in file.")

