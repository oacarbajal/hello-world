import csv
# Open the file in append mode to allow adding multiple students without
overwriting
with open('grades.csv', mode='a', newline='') as file:
 writer = csv.writer(file)
 while True:
 # Get student information
 first_name = input("Enter student's first name (or type 'done' to
finish): ")
 if first_name.lower() == 'done':
 break
 last_name = input("Enter student's last name: ")
 # Get and validate exam grades
 try:
 grade1 = int(input("Enter first exam grade: "))
 grade2 = int(input("Enter second exam grade: "))
 grade3 = int(input("Enter third exam grade: "))
 except ValueError:
 print("Please enter valid integer grades.")
 continue
 # Write the data to the CSV file
 writer.writerow([first_name, last_name, grade1, grade2, grade3])
 print("Record saved.\n")
